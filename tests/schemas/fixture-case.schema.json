{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policysql.dev/schemas/fixture-case.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "profile", "description", "covers", "tests", "expected"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "profile": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "covers": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "tests": {
      "type": "array",
      "items": { "enum": ["positive", "negative", "bypass", "differential"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "expected": { "enum": ["allow", "deny"] }
  }
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "policysql-sqlite-turso-dev",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  },
  "limits": {
    "cpu_ms": 50,
    "subrequests": 10
  },
  "ratelimits": [
    {
      "name": "POLICYSQL_RATE_LIMITER",
      "namespace_id": "73001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TRANSACTION_OWNER", "class_name": "TransactionOwner" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TransactionOwner"] }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.yaml"],
      "fallthrough": true
    }
  ],
  "vars": {
    "POLICYSQL_ENVIRONMENT": "development",
    "POLICYSQL_PUBLIC_BASE_URL": "https://gateway.example.com",
    "POLICYSQL_COST_CATALOG_JSON": "{\"maxEstimatedRowsRead\":10000,\"maxEstimatedRowsWritten\":100,\"resources\":{\"1\":{\"upperRows\":1000,\"uniqueSearchPatterns\":[\"sqlite_autoindex_archived_posts_1\"]},\"2\":{\"upperRows\":1000,\"uniqueSearchPatterns\":[\"sqlite_autoindex_authors_1\"]},\"3\":{\"upperRows\":10000,\"uniqueSearchPatterns\":[\"sqlite_autoindex_comments_1\"]},\"4\":{\"upperRows\":10000,\"uniqueSearchPatterns\":[\"sqlite_autoindex_posts_1\"]},\"5\":{\"upperRows\":10000,\"uniqueSearchPatterns\":[\"sqlite_autoindex_projects_1\"]}}}"
  },
  "secrets": {
    "required": [
      "POLICYSQL_JWKS_JSON",
      "POLICYSQL_JWT_ISSUER",
      "POLICYSQL_JWT_AUDIENCE",
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN"
    ]
  }
}

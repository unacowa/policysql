{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policysql.dev/schemas/atomic-execute.schema.json",
  "title": "PolicySQL atomic execute request",
  "type": "object",
  "additionalProperties": false,
  "required": ["statements"],
  "properties": {
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "policyVersion"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "string", "minLength": 1 }
      }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sql", "params"],
        "properties": {
          "sql": { "type": "string", "minLength": 1 },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "affectedRows": { "type": "integer", "minimum": 0 },
              "rowCount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}

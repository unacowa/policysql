{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policysql.dev/schemas/jwt-claims.schema.json",
  "title": "PolicySQL JWT claims",
  "type": "object",
  "required": ["iss", "aud", "sub", "iat", "exp", "policysql"],
  "properties": {
    "iss": { "type": "string", "minLength": 1 },
    "aud": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "sub": { "type": "string", "minLength": 1 },
    "iat": { "type": "integer" },
    "exp": { "type": "integer" },
    "nbf": { "type": "integer" },
    "policysql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "default_role", "access"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "default_role": { "$ref": "#/$defs/identifier" },
        "access": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["catalog", "explain", "execute", "debug"] }
        },
        "session": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              { "$ref": "#/$defs/identifier" },
              { "not": { "enum": ["subject_id", "role"] } }
            ]
          },
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policysql.dev/schemas/catalog-manifest.schema.json",
  "title": "PolicySQL Catalog manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "resources"],
  "properties": {
    "version": { "const": 1 },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "logicalType": { "enum": ["string", "integer", "int64", "number", "boolean", "bytes", "date", "datetime", "instant", "json"] },
    "format": { "enum": ["int64", "base64", "uuid", "email", "iso-date", "sqlite-datetime", "rfc3339"] },
    "scalar": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "enum": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/scalar" } },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string", "minLength": 1 }
      }
    },
    "jsonValueSchema": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
        "type": {
          "anyOf": [
            { "enum": ["null", "boolean", "integer", "number", "string", "array", "object"] },
            {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "enum": ["null", "boolean", "integer", "number", "string", "array", "object"] }
            }
          ]
        },
        "properties": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/jsonValueSchema" }
        },
        "items": { "$ref": "#/$defs/jsonValueSchema" },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": { "const": false },
        "anyOf": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/jsonValueSchema" }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/logicalType" },
        "representation": { "enum": ["string", "number", "boolean", "object", "array"] },
        "storage": { "enum": ["integer", "real", "text", "blob"] },
        "nullable": { "type": "boolean" },
        "format": { "$ref": "#/$defs/format" },
        "constraints": { "$ref": "#/$defs/constraints" },
        "jsonSchema": { "$ref": "#/$defs/jsonValueSchema" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "columns"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table"],
          "properties": { "table": { "$ref": "#/$defs/identifier" } }
        },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/column" }
        }
      }
    }
  }
}
